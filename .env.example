# Backend database and authentication
ALLOWED_ORIGINS=http://localhost:8081,https://nvcfoundationconnect.online
NVC_AUTH_SECRET=replace-with-a-long-random-secret
SUPABASE_DB_URL=postgresql://user:password@host:5432/database
DB_STRICT_POSTGRES=true
DB_CONNECT_TIMEOUT=10
DB_CANDIDATE_CONNECT_TIMEOUT=5
DB_CONNECT_MAX_ATTEMPTS=3
DB_CONNECT_RETRY_BASE_MS=250
DB_PROBE_CACHE_TTL_SECONDS=30
DB_FAILOVER_COOLDOWN_SECONDS=30
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# API URLs
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
VOLCRE_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WEB_API_BASE_URL=http://localhost:8000
VOLCRE_WEB_API_BASE_URL=http://localhost:8000

# Gmail delivery for OTPs and event reminder emails
OTP_GMAIL_SENDER=your-gmail-address@example.com
OTP_GMAIL_APP_PASSWORD=your-gmail-app-password

# Google and Firebase public client configuration
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_IDS=
# Server-side partner Google Calendar write-back configuration
GOOGLE_CALENDAR_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_WEBHOOK_URL=https://nvcfoundationconnect.online/api/google-calendar/partner/notifications
GOOGLE_CALENDAR_TIME_ZONE=Asia/Manila
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

VOLCRE_TRACE_STORAGE=false
